# Copy this file to .env, edit it, then run: docker compose up -d
# Put single quotes around any value that contains a $ sign.

# --- Login ---------------------------------------------------------------------------------
BASIC_AUTH_USER=admin
# Required: the app will not start until you set a password.
BASIC_AUTH_PASSWORD=
# 1 turns the login off. Only do this if something else already protects the app.
AUTH_DISABLED=0

# --- Folders -------------------------------------------------------------------------------
# Folder on this machine that holds Youtarr's downloads AND your libraries. The app sees it
# as /media. They must be on one filesystem, because files are hardlinked.
MEDIA_ROOT=/path/to/media
# Youtarr's metadata folder: jobs/info beside Youtarr's docker-compose.yml.
YOUTARR_INFO_DIR=/path/to/youtarr/jobs/info

# The folders below are inside MEDIA_ROOT and must already exist.
# Youtarr's download folder. Your media server must not scan it.
QUEUE_FOLDER=youtarr-queue
# Leave a library's folder blank to turn that library off. At least one is needed.
SHOWS_FOLDER=youtube-shows
MOVIES_FOLDER=youtube-movies
VIDEOS_FOLDER=videos
# Folder inside the videos library where video filings start. Blank files at the top level.
VIDEOS_SUBDIR=YouTube
MUSIC_FOLDER=youtube-music

# --- Container -----------------------------------------------------------------------------
# User and group to run as. Use the same IDs as Youtarr.
PUID=1000
PGID=1000
TZ=Etc/UTC
# Port on this machine.
PORT=8000

# --- Behaviour -----------------------------------------------------------------------------
# 1 previews only and writes nothing. Set to 0 once the previews look right.
DRY_RUN=1
# Optional Discord webhook for a ping when downloads wait too long. Blank is off.
DISCORD_WEBHOOK_URL=
# Optional Discord webhook for an alert when media is filed. Blank is off.
DISCORD_ADDED_WEBHOOK_URL=
# Age in days that triggers the waiting ping.
QUEUE_PING_DAYS=7
